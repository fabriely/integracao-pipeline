# Configurações do Banco de Dados PostgreSQL
# Copie este arquivo para .env e ajuste as configurações para seu ambiente

# Configurações Principais
DB_HOST=localhost
DB_PORT=5432
DB_NAME=escolas_dw
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Configurações Opcionais do Banco
DB_SCHEMA=dw
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Configurações da API - Portal de Dados Abertos
DADOS_ABERTOS_URL=http://dados.recife.pe.gov.br/
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3
API_DELAY_BETWEEN_REQUESTS=1

# URLs dos Datasets (atualizadas automaticamente)
DATASET_2024_URL=http://dados.recife.pe.gov.br/dataset/ce5168d4-d925-48f5-a193-03d4e0f587c7/resource/96f8a467-12b1-4340-b19c-281907fabaae/download/situacaofinal2024.csv
DATASET_2023_URL=http://dados.recife.pe.gov.br/dataset/ce5168d4-d925-48f5-a193-03d4e0f587c7/resource/854da2d7-c34b-457f-97b9-ba217d489621/download/situacaofinal2023.csv
DATASET_2022_URL=http://dados.recife.pe.gov.br/dataset/ce5168d4-d925-48f5-a193-03d4e0f587c7/resource/9e22fc25-716f-4454-8d95-998894b6ce01/download/situacaofinal2022.csv

# Paths
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_FINAL_PATH=data/final

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# ETL Configuration
BATCH_SIZE=1000
MAX_WORKERS=4

# Environment
ENVIRONMENT=development
DEBUG=True
